# Development defaults. Committed to git, so NEVER put real secrets here:
# use .env.local (git-ignored) for personal or secret values.
# Loaded when APP_ENV is not set (or APP_ENV=development).

# scaffold:begin db-layer
# Every database is optional and independent. Leave a value empty to turn that database off
# (in .env.local, which is git-ignored), or delete its code (see docs/DATABASES.md).

# scaffold:begin sqlite
# SQLite: a local file, no Docker. Active by default so the demo works out of the box.
SQLITE_URL=sqlite:///./dev.db

# scaffold:end sqlite
# scaffold:begin postgres
# PostgreSQL: ready to use after `pnpm db:up`. Matches docker-compose.yml.
# While it is not running it shows as "not available" and the API works anyway.
POSTGRES_URL=postgresql+psycopg://app:app@localhost:5432/app

# scaffold:end postgres
# scaffold:end db-layer
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
