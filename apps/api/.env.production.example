# Template for production. Do NOT put real values in this file.
# Option 1: copy to .env.production (git-ignored) and run with APP_ENV=production.
# Option 2 (preferred): set these variables in your hosting or CI. They win over any file.

# scaffold:begin db-layer
# Every database is optional. An empty value turns it off.
# scaffold:begin sqlite
# SQLite is a local file: usually off in production.
SQLITE_URL=
# scaffold:end sqlite
# scaffold:begin postgres
POSTGRES_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# scaffold:end postgres

# scaffold:end db-layer
# Allowed browser origins, comma-separated.
# The packaged desktop app does not need an entry: see docs/ELECTRON.md. # scaffold:line desktop
CORS_ORIGINS=https://your-web-app.example.com,https://your-landing.example.com
